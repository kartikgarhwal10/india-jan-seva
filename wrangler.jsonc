{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "india-jan-seva",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "india-jan-seva-db",
			"database_id": "93bcfa64-293a-4250-98bb-40850d8f1bcc"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "india-jan-seva"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
